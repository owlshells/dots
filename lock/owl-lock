#!/bin/sh
# owl-lock — lock the screen, and fail closed if the pretty path breaks.
#
# Both $mod+Escape and xss-lock go through this rather than calling
# betterlockscreen directly, so that the idle timeout gets the same fallback the
# keybinding does. xss-lock takes a command, not a shell expression, so `a || b`
# written on the bindsym line would have protected only the binding.
#
# NOT `exec betterlockscreen -l || exec i3lock`, which is what this was:
#
#     exec betterlockscreen -l 2>/dev/null || exec i3lock -c 282828 -n
#
# exec replaces this process, so the moment betterlockscreen starts, its exit
# status IS this script's exit status and the || branch is unreachable code. The
# fallback fired only when exec itself failed -- i.e. betterlockscreen not
# installed at all -- and never for the case it was written for, which is
# betterlockscreen starting, failing, and leaving the screen unlocked.
#
#     $ sh -c 'exec false || echo fallback'   # prints nothing, exits 1
#
# The exec was there so xss-lock's signals would reach the locker instead of a
# wrapper shell. That never worked either: betterlockscreen is itself a shell
# script that runs i3lock as a child, so there has always been a shell in the
# middle, and this adds no layer that was not there before.
#
# Ways betterlockscreen -l exits non-zero, all of which now actually fall back:
#   - its per-resolution cache is missing (betterlockscreen -u never ran)
#   - i3lock rejects a flag, e.g. lock/betterlockscreenrc asks for the box
#     indicator on a box where lock/build.sh has not been run
#   - a display/xrandr hiccup while it works out which cache to use
betterlockscreen -l 2>/dev/null && exit 0

# The fallback has to actually appear, which `i3lock -c` on its own does not
# reliably do. i3lock only starts its periodic redraw when there is something
# that needs one:
#
#     if (show_clock || bar_enabled || slideshow_enabled) { ... }
#
# With none of those it paints once, at map time, and then nothing until an
# input event forces a redraw. Under a compositor that first paint can be
# missed, and the result is a locked machine still showing the desktop until a
# key is pressed -- which looks exactly like a machine that did not lock, and
# invites walking away from one that has not.
#
# --clock is what starts the tick, so the screen repaints every second and
# corrects itself within one. --indicator keeps the ring up as well: this is the
# degraded path, and looking obviously different from the usual lock screen is a
# feature here, not a regression.
#
# Probed with --version rather than assumed, because plain i3lock has no --clock
# and would exit on the unknown option -- turning a cosmetic problem into an
# unlocked screen. --version parses options left to right and exits before
# touching the display, so the probe costs nothing.
if i3lock --clock --version >/dev/null 2>&1; then
    exec i3lock -c 282828 -n --clock --force-clock --indicator
fi

# Vanilla i3lock. No image, no styling, and none of it matters. The only
# property being defended here is that something has the screen.
exec i3lock -c 282828 -n
