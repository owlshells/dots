+/* Box indicator: a password field that shakes when the password is wrong.
+ * Drawn instead of the ring, the way the bar is. It borrows the ring and
+ * inside colors for its border and fill so an existing palette carries over
+ * unchanged; only the dot color is its own. */
+extern bool box_enabled;
+extern double box_width;
+extern double box_height;
+extern double box_radius;
+extern double box_border_width;
+extern double box_dot_radius;
+extern double box_dot_gap;
+extern char box_dot_color[9];
+
+/* Shake: a sine damped by a decaying exponential, offsetting the box on the x
+ * axis only. shake_start is the CLOCK_MONOTONIC second at which the current
+ * shake began, or 0 when the box is at rest. i3lock.c owns it, because that is
+ * where the authentication result arrives and where the ev loop lives. */
+extern double shake_amplitude;
+extern double shake_frequency;
+extern double shake_duration;
+extern double shake_start;
+
+/* Rate limit, owned by i3lock.c along with the rest of the auth state. */
+extern int lockout_after;
+extern char *lockout_text;
+int throttle_remaining(void);
+
+rgba_t boxdot16;
+
 static cairo_font_face_t *font_faces[6] = {
     NULL,
     NULL,
@@ -518,6 +547,122 @@ static void draw_bar(cairo_t *ctx, double bar_x, double bar_y, double bar_width,
     cairo_restore(ctx);
 }
 
+/* Monotonic seconds. Deliberately not the wall clock: the shake is a duration,
+ * and a clock step from NTP or a suspend/resume mid-shake would otherwise make
+ * the box either freeze mid-swing or jump. */
+double monotonic_now(void) {
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+        return 0.0;
+    return (double)ts.tv_sec + (double)ts.tv_nsec / 1000000000.0;
+}
+
+/* Horizontal offset of the box for the current frame. Zero at rest, and zero
+ * again once the shake has run its course, so a missed final redraw can never
+ * strand the box off-center. */
+static double shake_offset(void) {
+    if (shake_start <= 0.0 || shake_duration <= 0.0)
+        return 0.0;
+
+    double t = monotonic_now() - shake_start;
+    if (t < 0.0 || t >= shake_duration)
+        return 0.0;
+
+    /* Decay to ~e^-5 (under 1% of amplitude) by the end of the duration, so the
+     * box arrives at rest rather than being cut off mid-swing. */
+    double decay = exp(-5.0 * t / shake_duration);
+    return shake_amplitude * decay * sin(2 * M_PI * shake_frequency * t);
+}
+
+static void rounded_rect(cairo_t *ctx, double x, double y, double w, double h, double r) {
+    if (r < 0.0)
+        r = 0.0;
+    if (r > w / 2)
+        r = w / 2;
+    if (r > h / 2)
+        r = h / 2;
+
+    cairo_new_sub_path(ctx);
+    cairo_arc(ctx, x + w - r, y + r,     r, -M_PI / 2, 0);
+    cairo_arc(ctx, x + w - r, y + h - r, r, 0, M_PI / 2);
+    cairo_arc(ctx, x + r,     y + h - r, r, M_PI / 2, M_PI);
+    cairo_arc(ctx, x + r,     y + r,     r, M_PI, 3 * M_PI / 2);
+    cairo_close_path(ctx);
+}
+
+/* The password field. Unlike the ring this is drawn unconditionally: a login
+ * box that only appears once you have already started typing is not the
+ * affordance we are after -- the point is to show where the password goes
+ * before the first keystroke. */
+static void draw_box(cairo_t *ctx, double ind_x, double ind_y) {
+    cairo_save(ctx);
+
+    double x = ind_x - box_width / 2 + shake_offset();
+    double y = ind_y - box_height / 2;
+
+    /* Fill and border both track the PAM state, matching what the ring does.
+     * A rate limit in force reads as wrong for as long as it lasts: the wrong
+     * state itself clears after two seconds, and a box that went back to its
+     * resting colour while still refusing to accept a password would be
+     * lying about whether you can try again. */
+    rgba_t fill = inside16, border = ring16;
+    if (throttle_remaining() > 0) {
+        fill = insidewrong16;
+        border = ringwrong16;
+    } else {
+        switch (auth_state) {
+            case STATE_AUTH_VERIFY:
+            case STATE_AUTH_LOCK:
+                fill = insidever16;
+                border = ringver16;
+                break;
+            case STATE_AUTH_WRONG:
+            case STATE_I3LOCK_LOCK_FAILED:
+                fill = insidewrong16;
+                border = ringwrong16;
+                break;
+            default:
+                break;
+        }
+    }
+
+    rounded_rect(ctx, x, y, box_width, box_height, box_radius);
+    cairo_set_source_rgba(ctx, fill.red, fill.green, fill.blue, fill.alpha);
+    cairo_fill_preserve(ctx);
+    cairo_set_line_width(ctx, box_border_width);
+    cairo_set_source_rgba(ctx, border.red, border.green, border.blue, border.alpha);
+    cairo_stroke(ctx);
+
+    /* One dot per byte of input. input_position is a byte count, so a
+     * multibyte character draws more than one dot -- accepted deliberately:
+     * the alternative is reaching into the password buffer from the drawing
+     * code, and the buffer is better left where it is. The count is clamped to
+     * what fits, which doubles as a cap on how much of the length is on show.*/
+    int dots = input_position;
+    if (dots > 0) {
+        double step = box_dot_radius * 2 + box_dot_gap;
+        double usable = box_width - 2 * (box_border_width + box_dot_gap);
+        int max_dots = (step > 0.0) ? (int)((usable + box_dot_gap) / step) : 0;
+
+        if (max_dots < 1)
+            max_dots = 1;
+        if (dots > max_dots)
+            dots = max_dots;
+
+        double row = (dots - 1) * step + box_dot_radius * 2;
+        double dot_x = x + (box_width - row) / 2 + box_dot_radius;
+        double dot_y = y + box_height / 2;
+
+        cairo_set_source_rgba(ctx, boxdot16.red, boxdot16.green, boxdot16.blue, boxdot16.alpha);
+        for (int i = 0; i < dots; ++i) {
+            cairo_arc(ctx, dot_x + i * step, dot_y, box_dot_radius, 0, 2 * M_PI);
+            cairo_fill(ctx);
+        }
+    }
+
+    cairo_restore(ctx);
+}
