  * authentication event.
  *
  */
+/* Drives the shake. Every other redraw in i3lock is event driven -- a
+ * keystroke, a PAM result, the clock tick -- and none of those fire during the
+ * half second after a failed password, so an animation needs a tick of its
+ * own. It runs only while the box is actually moving and stops itself
+ * afterwards, so an idle lock screen still redraws no more than it did before.
+ */
+#define SHAKE_FPS 60.0
+
+static void shake_tick_cb(EV_P_ ev_timer *w, int revents) {
+    bool done = (shake_start <= 0.0) ||
+                (monotonic_now() - shake_start >= shake_duration);
+    if (done) {
+        /* Clear first, then redraw, so the last frame drawn is the box at
+         * rest. Leaving it stopped mid-swing is the one visible way this can
+         * fail. */
+        shake_start = 0.0;
+        ev_timer_stop(main_loop, w);
+    }
+    redraw_screen();
+}
+
+static void start_shake(void) {
+    if (!box_enabled || shake_duration <= 0.0)
+        return;
+
+    shake_start = monotonic_now();
+
+    if (shake_tick == NULL) {
+        shake_tick = calloc(1, sizeof(struct ev_timer));
+        /* No memory means no animation, and that is the end of it. We cannot
+         * exit() here -- that would unlock the screen -- and a box that fails
+         * to shake is a cosmetic loss, not a security one. */
+        if (shake_tick == NULL)
+            return;
+        ev_timer_init(shake_tick, shake_tick_cb, 0., 1.0 / SHAKE_FPS);
+    }
+    ev_timer_again(main_loop, shake_tick);
+}
