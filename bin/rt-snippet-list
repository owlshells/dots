#!/usr/bin/env bash
# rt-snippet-list — render snippets/*.txt for the picker.
#
# Emits: category \t label \t command   (templates unsubstituted)
#
# Placeholders are deliberately left as {{NAME}} here. Filling them happens in
# zsh at insert time, where parameter expansion is literal — a password
# containing & or | or \ would corrupt a sed-based substitution, and passwords
# containing exactly those characters are not rare.
#
# File format: a "# label" line followed by one or more command lines. A blank
# line ends an entry, which is what keeps the file's own header comments from
# being mistaken for labels.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
dir="${RT_SNIPPETS:-$here/snippets}"
[ -d "$dir" ] || exit 0

for f in "$dir"/*.txt; do
    [ -r "$f" ] || continue
    cat="$(basename "$f" .txt)"
    awk -v cat="$cat" '
        /^[[:space:]]*$/            { label = ""; next }
        /^#/                        { label = substr($0, 2)
                                      sub(/^[[:space:]]+/, "", label); next }
        label != ""                 { printf "%-9s\t%s\t%s\n", cat, label, $0 }
    ' "$f"
done
