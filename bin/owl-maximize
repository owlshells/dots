#!/bin/sh
# owl-maximize — $mod+f, doing the sensible thing for the window you are on.
#
#   tiled window     -> i3's real fullscreen, which is what it should be
#   floating window  -> fill the workspace, leaving polybar visible, and toggle
#                       back to where it was on a second press
#
# i3 cannot express the floating half on its own. `fullscreen` on a floating
# window covers the whole output including the bar, and `resize set 100 ppt
# 100 ppt` is no help because ppt resolves against the *output*, not the
# workspace: on a 1920x1200 panel with a 32px bar that produces a 1200-tall
# window sitting 16px above where it should be, straddling the bar. The
# workspace rect is the number that matters and only i3 knows it, so ask.
set -eu

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/owl-maximize"
mkdir -p "$STATE_DIR"

focused=$(i3-msg -t get_tree \
    | jq -c 'first(recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true))')
[ -n "$focused" ] && [ "$focused" != "null" ] || exit 0

case $(printf '%s' "$focused" | jq -r '.floating // "auto_off"') in
    user_on|auto_on) ;;
    *) exec i3-msg -q 'fullscreen toggle' ;;
esac

id=$(printf '%s' "$focused" | jq -r '.id')
state="$STATE_DIR/$id"

# The state file is the toggle, rather than comparing the current geometry
# against the workspace: a floating container carries its border, so a
# maximised window's rect is a few pixels off the workspace rect and never
# compares equal. Presence of the file is unambiguous.
if [ -f "$state" ]; then
    # shellcheck disable=SC2046 # deliberate: four fields into four arguments
    set -- $(cat "$state")
    rm -f "$state"
else
    printf '%s' "$focused" | jq -r '"\(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height)"' >"$state"
    # shellcheck disable=SC2046
    set -- $(i3-msg -t get_workspaces \
        | jq -r '.[] | select(.focused) | "\(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height)"')
fi

i3-msg -q "resize set $3 px $4 px, move position $1 px $2 px"
