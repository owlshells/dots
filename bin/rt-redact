#!/usr/bin/env bash
# rt-redact — strip credentials from command lines on stdin.
#
# The scrub-path mirror of _rt_redact_r in shell/zsh/redact.zsh. Two
# implementations exist because the live path runs from preexec on every
# command and must not fork, while this one has to work on files from bash.
# tools/selftest.zsh asserts the two agree on a shared corpus.
#
# Reads command lines on stdin, writes redacted ones on stdout.
#
#   rt-redact < commands.log
#   printf '%s\n' "nxc smb h -u a -p Passw0rd" | rt-redact
set -euo pipefail

MARK="${RT_REDACT_MARK:-{{redacted\}\}}"
MARK="${MARK//\\/}"

exec awk -v mark="$MARK" '
# Split on shell words, not on whitespace, so a quoted value stays one token.
# Splitting on whitespace leaks: `-p '\''Pass word 1'\''` redacts only "'\''Pass" and
# writes "word 1'\''" straight to the log. This mirrors zsh ${(z)} closely enough
# for the job; it does not model backslash escaping, which the live path does.
function tokenize(s, arr,   i, c, tok, q, n) {
    n = 0; tok = ""; q = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") {
            tok = tok c
            if (c == q) q = ""
        } else if (c == "\x27" || c == "\"") {
            q = c; tok = tok c
        } else if (c == " " || c == "\t") {
            if (tok != "") { arr[++n] = tok; tok = "" }
        } else {
            tok = tok c
        }
    }
    if (tok != "") arr[++n] = tok
    return n
}
function is_secret(v) {
    if (v == "" || v == "\x27\x27" || v == "\"\"") return 0   # null session, not a secret
    return 1
}
# All-digits is only ambiguous after a SHORT flag, where -p might be nmap"s port
# list. After --password, or in PASSWORD=, the value is a password whatever it
# looks like. Mirrors _rt_is_port_list in shell/zsh/redact.zsh.
function is_port_list(v) {
    return (v ~ /^[0-9,-]+$/)
}
# -H is a hash in netexec but the HOST in smbmap. Judge the value, not the flag.
function is_hash_value(v) {
    gsub(/[\x27"]/, "", v); gsub(/:/, "", v)
    return (length(v) >= 16 && v ~ /^[0-9a-fA-F]+$/)
}
# Short -p is ambiguous (password in netexec, make-parents in mkdir, preserve
# in cp, port in nmap/psql) so it is only honoured for commands whose -p really
# is a password. Long forms are unambiguous. Mirrors shell/zsh/redact.zsh.
function is_pw_flag_long(f) {
    return (f=="--password" || f=="--pass" || f=="--passwd" || f=="--pw")
}
function is_pw_flag_short(f) {
    return (f=="-p" || f=="-P")
}
function is_pw_tool(c) {
    if (c ~ /^impacket-/) return 1
    return (c=="nxc" || c=="netexec" || c=="crackmapexec" || c=="cme" || c=="smbmap" ||
            c=="sshpass" || c=="evil-winrm" || c=="hydra" || c=="medusa" ||
            c=="mongo" || c=="mongosh" || c=="mysql" || c=="mysqldump")
}
function is_wrapper(c) {
    return (c=="sudo" || c=="doas" || c=="proxychains" || c=="proxychains4" ||
            c=="env" || c=="time" || c=="watch" || c=="nohup" || c=="stdbuf")
}
function basename_(s,   n, a) { n = split(s, a, "/"); return a[n] }
# Effective command, wrappers and leading VAR=val peeled off.
function eff_cmd(arr, n,   i, b) {
    for (i = 1; i <= n; i++) {
        if (index(arr[i], "=") > 0) continue
        b = basename_(arr[i])
        if (is_wrapper(b)) continue
        return b
    }
    return ""
}
function is_hash_flag(f) {
    return (f=="-H" || f=="--hash" || f=="-hashes" || f=="--hashes" || f=="-nthash" || f=="--nt-hash" || f=="--ntlm-hash")
}
function is_user_flag(f) {
    return (f=="-U" || f=="--user" || f=="--username")
}
function is_secret_name(n) {
    return (toupper(n) ~ /^(P|PW|PASS|PASSWD|PASSWORD|TOKEN|SECRET|APIKEY|API_KEY|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|GITHUB_TOKEN|DOTS_TOKEN)$/)
}
# domain/user:secret@target — impacket specs and credentialed URLs
# pwdump format — user:rid:lmhash:nthash:::  Mirrors rule 5 in redact.zsh. The
# only rule that is not about a command line: secretsdump and friends emit this
# as output, and it reaches disk through tmux pane logging. Name and RID are kept
# deliberately; which accounts were dumped is the finding, the hashes are the
# secret. `j` is a parameter, not a global — the main loop uses `i`.
function mask_pwdump(s,   a, n, j, res) {
    n = split(s, a, ":")
    if (n < 4)                                  return s
    if (a[2] !~ /^[0-9]+$/)                     return s
    if (!is_hash_value(a[3]) || !is_hash_value(a[4])) return s
    a[3] = mark; a[4] = mark
    res = a[1]
    for (j = 2; j <= n; j++) res = res ":" a[j]
    return res
}
function mask_colon_at(s,   at, pre, rest) {
    at = index(s, "@")
    if (at < 2) return s
    pre = substr(s, 1, at - 1); rest = substr(s, at)
    if (match(pre, /:[^:@ \t]*$/)) return substr(pre, 1, RSTART) mark rest
    return s
}
# NetNTLMv1/v2 — user::DOMAIN:challenge:response[:blob]. Mirrors rule 6.
# Keeps account and domain; the long-hex test is what stops an IPv6 address,
# whose groups are four hex characters at most, from matching the same shape.
function has_long_hex(s) { return (s ~ /[0-9a-fA-F]{32,}/) }
function mask_netntlm(s) {
    if (match(s, /^[^:[:space:]]+::[^:[:space:]]+:/))
        return substr(s, 1, RSTART + RLENGTH - 1) mark
    return s
}
# Kerberos crackables — $krb5tgs$ $krb5asrep$ $krb5pa$ $DCC2$. Mirrors rule 7.
# The principal lives in the header and the crackable material at the end, so
# masking the long hex runs keeps the account and drops what hashcat wants.
function mask_krb(s,   out, rest) {
    out = ""; rest = s
    while (match(rest, /[0-9a-fA-F]{32,}/)) {
        out = out substr(rest, 1, RSTART - 1) mark
        rest = substr(rest, RSTART + RLENGTH)
    }
    return out rest
}
# secretsdump kerberos keys — principal:aes256-cts-hmac-sha1-96:<key>. Rule 8.
function is_krb_etype(a) {
    return (a ~ /^aes[0-9]+-cts-[^:[:space:]]+$/ || a == "des-cbc-md5" ||
            a == "des3-cbc-sha1" || a ~ /^rc4_hmac[^:[:space:]]*$/ ||
            a ~ /^arcfour-hmac[^:[:space:]]*$/)
}
function mask_krb_key(s,   a, n, j, res) {
    n = split(s, a, ":")
    if (n < 3)                  return s
    if (!is_krb_etype(a[2]))    return s
    if (!is_hash_value(a[3]))   return s
    a[3] = mark
    res = a[1]
    for (j = 2; j <= n; j++) res = res ":" a[j]
    return res
}
# Private key blocks. The scrub path only: shell/zsh/redact.zsh is handed one
# command line at a time and has no way to know it is inside a block, so this is
# the one deliberate asymmetry between the two engines, and the shared corpus in
# tools/selftest.zsh does not carry it.
#
# The BEGIN/END markers are kept and every body line becomes one mark line. That
# is not cosmetic: tools/scrub-logs.sh splits each file into prefixes and bodies
# and rejoins them by line number, so a rule that collapsed a 40-line key into
# one line would misalign every following line in the file. One line in, one
# line out.
/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/ { inkey = 1; print; fflush(); next }
inkey && /-----END [A-Z0-9 ]*PRIVATE KEY-----/ { inkey = 0; print; fflush(); next }
inkey { print mark; fflush(); next }

# mimikatz / LSA cleartext — `* Password : hunter2`. Mirrors rule 0.
# A line rule, because a cleartext password may contain spaces and tokenising
# would only find the first word of it. `(null)` is mimikatz reporting nothing
# was there, which is half the finding, so it is kept.
match($0, /^[[:space:]]*\*?[[:space:]]*Password[[:space:]]*:[[:space:]]+/) {
    val = substr($0, RSTART + RLENGTH)
    if (val != "" && val != "(null)") {
        print substr($0, 1, RSTART + RLENGTH - 1) mark
        fflush()
        next
    }
}

{
    n = tokenize($0, w)
    pw_short = is_pw_tool(eff_cmd(w, n))
    out = ""; prev = ""
    for (i = 1; i <= n; i++) {
        cur = w[i]; eq = index(cur, "=")
        if (prev != "" && is_secret(cur) && \
            (is_pw_flag_long(prev) || \
             (pw_short && is_pw_flag_short(prev) && !is_port_list(cur)) || \
             (is_hash_flag(prev) && is_hash_value(cur)))) {
            cur = mark
        } else if (eq > 1) {
            name = substr(w[i], 1, eq - 1); val = substr(w[i], eq + 1)
            if (is_secret(val) && (is_pw_flag_long(name) || is_hash_flag(name) ||
                                   is_secret_name(name) ||
                                   (pw_short && is_pw_flag_short(name) && !is_port_list(val))))
                cur = name "=" mark
        } else if ((prev != "" && is_user_flag(prev) && index(cur, "%") > 0) || cur ~ /^-U.+%/) {
            q = ""                                              # keep a closing quote
            first = substr(cur, 1, 1); last = substr(cur, length(cur), 1)
            if ((first == "\x27" || first == "\"") && first == last) q = last
            cur = substr(cur, 1, index(cur, "%")) mark q         # smbclient user%pass
        } else if (w[i] ~ /:[^:@ \t]+@/) {
            cur = mask_colon_at(w[i])
        } else if (w[i] ~ /^[^:[:space:]]+:[0-9]+:[0-9a-fA-F]{16,}:[0-9a-fA-F]{16,}/) {
            cur = mask_pwdump(w[i])
        } else if (w[i] ~ /^[^:[:space:]]+::[^:[:space:]]+:/ && has_long_hex(w[i])) {
            cur = mask_netntlm(w[i])
        } else if (w[i] ~ /^\$krb5/ || w[i] ~ /^\$DCC2\$/) {
            cur = mask_krb(w[i])
        } else if (w[i] ~ /^[^:[:space:]]+:[a-z0-9_-]+:[0-9a-fA-F]{16,}/) {
            cur = mask_krb_key(w[i])
        }
        out = (out == "" ? cur : out " " cur)
        prev = w[i]
    }
    # Only emit the rebuilt line when something was redacted; otherwise print
    # the input verbatim, so whitespace and indentation survive untouched.
    print (index(out, mark) ? out : $0)
    # Required when this is a live filter on a tmux pipe-pane: awk block-buffers
    # a pipe, so without the flush a transcript lags by kilobytes and a `tail -f`
    # shows nothing. Immaterial to the batch path, which is redirected to a file.
    fflush()
}
'
